{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      },
      "cache": {
        "key": "v1-dependencies",
        "paths": [
          "node_modules"
        ]
      }
    },
    "production": {}
  },
  "submit": {
    "production": {}
  }
}
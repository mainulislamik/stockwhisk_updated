# StockWhisk — PRODUCTION docker-compose env.
# Copy this file to your VPS as `.env` in the project root.

DEBUG=False
# SECURITY WARNING: change this to a long random string in production!
SECRET_KEY=REPLACE_WITH_A_VERY_LONG_SECURE_RANDOM_STRING

# Put your VPS IP address or domain name here. Use '*' to allow any for testing.
ALLOWED_HOSTS=*

# If using a domain or https later, update this. For now, matching the IP is good.
CSRF_TRUSTED_ORIGINS=http://your_vps_ip_here

TIME_ZONE=Asia/Dhaka
SECURE_SSL_REDIRECT=False

# Database (compose creates this postgres with these values)
DB_ENGINE=postgres
DB_NAME=stockwhisk
DB_USER=stockwhisk
# SECURITY WARNING: change this password in production!
DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Email (optional)
# EMAIL_HOST=smtp.provider.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=StockWhisk <no-reply@example.com>

CORS_ALLOW_ALL_ORIGINS=True
AUTH_THROTTLE_RATE=10/min
WEB_CONCURRENCY=5

# Host port nginx binds to - Port 80 for standard web traffic
HTTP_PORT=80

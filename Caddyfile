{
	# Position the rate-limit handler in the directive order.
	order rate_limit before basicauth
}

stockwhisk.com, www.stockwhisk.com {
	# Reject oversized request bodies early (cheap DoS via huge uploads).
	request_body {
		max_size 20MB
	}

	handle_path /media/* {
		root * /app/media
		file_server
	}
	handle_path /static/* {
		root * /app/staticfiles
		file_server
	}

	# Per-IP flood guard for the DB-backed backend only (Django + Postgres). It
	# deliberately does NOT cover static assets or the Next.js app: a single SPA
	# page load pulls dozens of JS chunks, so a few quick reloads would otherwise
	# blow a whole-site budget and get legit users 429'd (and bounced to login).
	# A scripted flood against /api or /admin from one IP is still capped at 429.
	@backend path /api/* /admin/*
	handle @backend {
		rate_limit {
			zone sw_backend {
				key    {remote_host}
				events 300
				window 10s
			}
		}
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}

mail.stockwhisk.com {
	handle /sso* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy roundcube:80
	}
}
